{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stuff",
  "version": "0.1.0",
  "identifier": "dev.stuff.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui",
      "wait": true
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stuff",
        "width": 1500,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 680,
        "maximized": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"]
  }
}
