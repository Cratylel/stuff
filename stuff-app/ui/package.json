{
  "name": "stuff-desktop-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "tauri:dev": "cd .. && npm --prefix ui exec tauri -- dev",
    "tauri:build": "cd .. && npm --prefix ui exec tauri -- build"
  },
  "dependencies": {
    "@mantine/core": "8.3.14",
    "@mantine/form": "8.3.14",
    "@mantine/hooks": "8.3.14",
    "@tauri-apps/api": "^2.9.0",
    "@vitejs/plugin-react": "^6.1.0",
    "konva": "^9.3.18",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
